# ====================================================================
# Engineerus Quest — environment variables
# ====================================================================
# Copy this file to `.env` (in the same directory) and fill in real values.
# NEVER commit your real `.env` file to git.

# --- Backend: Groq AI API keys ---
# Required for the AI Tutor / MaterialSwap / PatentCraft / EngiLegal / EngiMatch
# modules to work. Without it the server falls back to a Demo-Mode stub.
# Get a free key at: https://console.groq.com/keys
# Primary key used whenever it is configured.
GROQ_API_KEY="your_groq_api_key_here"

# Optional secondary key used only when GROQ_API_KEY is absent.
# HTTP 429 responses do not automatically switch to this secondary key.
# GROQ_API_KEY_2="your_secondary_groq_api_key_here"

# --- Backend: HTTP port ---
# Optional. Defaults to 3000 if unset.
# PORT=3000

# --- Frontend (Vite): backend API URL ---
# Used by the React app to know where the Express backend lives.
# In local dev with `npm run dev`, leave this empty so the frontend calls
# same-origin routes (the Vite dev server proxies them).
# In production (e.g. Render/Vercel), set this to your deployed backend URL,
# e.g. https://engineerus-quest.onrender.com
VITE_API_URL=""
